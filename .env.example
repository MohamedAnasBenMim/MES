# MES PLATFORM - ENVIRONMENT VARIABLES TEMPLATE
# ------------------------------------------------
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in real values in .env (passwords, API keys)
#   3. .env is in .gitignore so it will NEVER be pushed to GitHub
#   4. docker-compose.yml reads from .env automatically

# --- PostgreSQL Database ---
POSTGRES_DB=mes_db
POSTGRES_USER=mes_user
POSTGRES_PASSWORD=CHANGE_ME_to_a_strong_password

# --- Django Backend ---
SECRET_KEY=CHANGE_ME_to_a_random_50_char_string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Email / SMTP ---
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password-here
